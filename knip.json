{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/lib/popover/store/*.ts",
    "src/lib/popover/store/**/index.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "rules": {
    "exports": "off",
    "types": "off",
    "duplicates": "off"
  },
  "ignoreDependencies": ["repomix"],
  "ignoreExportsUsedInFile": true
}
