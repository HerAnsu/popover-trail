  "jsPlugins": [
    {
      "name": "sonarjs",
      "specifier": "eslint-plugin-sonarjs"
    },
    {
      "name": "regexp",
      "specifier": "eslint-plugin-regexp"
    },
    {
      "name": "@e18e",
      "specifier": "@e18e/eslint-plugin"
    },
    {
      "name": "@stylistic",
      "specifier": "@stylistic/eslint-plugin"
    },
    {
      "name": "testing-library",
      "specifier": "eslint-plugin-testing-library"
    },
    {
      "name": "storybook",
      "specifier": "eslint-plugin-storybook"
    },
    {
      "name": "popover",
      "specifier": "./tools/eslint-plugin-popover/index.js"
    }
