{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-perf",
    "import",
    "jsx-a11y",
    "promise",
    "unicorn",
    "oxc",
    "jsdoc",
    "node",
    "vitest"
